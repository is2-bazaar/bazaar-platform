# Overrides opcionales.
# Este archivo NO se ejecuta automaticamente salvo que se copie como `.env.local`.

# ENV_NAME=local
# BAZAAR_BACKEND_PATH=/ruta/a/bazaar-backend
# BAZAAR_BACKOFFICE_PATH=/ruta/a/bazaar-backoffice
# BAZAAR_MOBILE_PATH=/ruta/a/bazaar-mobile
# BACKEND_PROVIDER=local-docker
# DATABASE_PROVIDER=local-docker
# BACKOFFICE_PROVIDER=local-vite
# MOBILE_RUNTIME_MODE=manual
# LOCAL_API_BASE_URL=http://localhost:8080
# BACKOFFICE_DEV_URL=http://localhost:5173
# MOBILE_API_BASE_URL=http://localhost:8080

# Nota: para mobile en emulador o dispositivo fisico puede convenir usar la IP del host
# o el alias del emulador en lugar de localhost.
