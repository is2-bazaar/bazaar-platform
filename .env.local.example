# Overrides opcionales.
# Este archivo NO se ejecuta automaticamente salvo que se copie como `.env.local`.

# ENV_NAME=local
# BAZAAR_API_GATEWAY_PATH=/ruta/a/Bazaar-backend-api-gateway
# BAZAAR_AUTH_SERVICE_PATH=/ruta/a/bazaar-backend-auth-service
# BAZAAR_CART_SERVICE_PATH=/ruta/a/bazaar-backend-cart-service
# BAZAAR_CATALOG_SERVICE_PATH=/ruta/a/bazaar-backend-catalog-service
# BAZAAR_ORDER_SERVICE_PATH=/ruta/a/bazaar-backend-order-service
# BAZAAR_PAYMENT_SERVICE_PATH=/ruta/a/bazaar-backend-payment-service
# BAZAAR_RECOMMENDATION_SERVICE_PATH=/ruta/a/bazaar-backend-recommendation-service
# BAZAAR_USER_SERVICE_PATH=/ruta/a/bazaar-backend-user-service
# BAZAAR_BACKOFFICE_PATH=/ruta/a/bazaar-backoffice
# BAZAAR_MOBILE_PATH=/ruta/a/bazaar-mobile
# BACKEND_PROVIDER=local-docker
# DATABASE_PROVIDER=local-docker
# BACKOFFICE_PROVIDER=local-vite
# MOBILE_RUNTIME_MODE=local-expo
# LOCAL_API_BASE_URL=http://localhost:8080
# BACKOFFICE_DEV_URL=http://localhost:5173
# MOBILE_API_BASE_URL=http://localhost:8080
# MOBILE_DEV_URL=http://localhost:8081
# USER_DB_HOST_PORT=5433
# AUTH_DB_HOST_PORT=5440
# CATALOG_DB_HOST_PORT=5434
# CART_DB_HOST_PORT=5436
# CART_DB_NAME=cart_db
# ORDER_DB_HOST_PORT=5437
# PAYMENT_DB_HOST_PORT=5438
# RECOMMENDATION_SERVICE_HOST_PORT=18087
# RECOMMENDATION_SERVICE_URL=http://recommendation-service:8080
# RECOMMENDATION_MONGO_URL=mongodb://recommendation-db:27017
# RECOMMENDATION_DB_NAME=recommendations
# Si ya tenés MongoDB local en 27017, cambiá este binding a 27018 u otro puerto libre.
# RECOMMENDATION_DB_HOST_PORT=27017
# RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# RABBITMQ_EXCHANGE=bazaar.events
# RABBITMQ_RECOMMENDATION_QUEUE=recommendations.events
# RABBITMQ_AMQP_HOST_PORT=5672
# RABBITMQ_MGMT_HOST_PORT=15672
# Credenciales SOLO para desarrollo local.
# RABBITMQ_DEFAULT_USER=guest
# RABBITMQ_DEFAULT_PASS=guest
# INTERNAL_SERVICE_TOKEN=

# JWT_SECRET=

# Integration test accounts (used by scripts/test/integration/)
# JWT_SECRET=your-jwt-secret-placeholder
# INTERNAL_SERVICE_TOKEN=your-internal-token-placeholder
# PASSWORD=your-test-password-placeholder
# ADMIN_EMAIL=admin@bazaar.dev
# ADMIN_PASSWORD=your-admin-password-placeholder

# PLATFORM_LAN_IP=192.168.1.4
# `bazaar-platform` deriva GATEWAY_ALLOWED_ORIGINS usando BACKOFFICE_DEV_URL,
# MOBILE_DEV_URL y PLATFORM_LAN_IP. No hace falta definirlo a mano.

# Nota: para mobile en emulador o dispositivo fisico puede convenir usar la IP del host
# o el alias del emulador en lugar de localhost.

# =============================================================================
# Redis Rate Limiting Configuration
# =============================================================================
# Overrides para Redis local. Defaults en defaults.env.
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_HOST_PORT=6379
#
# Gateway Redis (limiter principal + fallback in-memory)
# GATEWAY_REDIS_ENABLED=true
# GATEWAY_REDIS_HOST=redis
# GATEWAY_REDIS_PORT=6379
# GATEWAY_REDIS_DB=0
# GATEWAY_REDIS_PASSWORD=
# GATEWAY_REDIS_TIMEOUT_MS=100
# GATEWAY_REDIS_DIAL_TIMEOUT_MS=2000
# GATEWAY_REDIS_PREFIX=rl
# GATEWAY_USER_RATE_LIMIT_WINDOW_SECONDS=60
# GATEWAY_USER_RATE_LIMIT_MAX_REQUESTS=60
#
# Auth Redis (login + reset-password)
# AUTH_REDIS_HOST=redis
# AUTH_REDIS_PORT=6379
# AUTH_REDIS_DB=1
# AUTH_REDIS_PASSWORD=
# AUTH_REDIS_TIMEOUT_MS=100
# AUTH_REDIS_DIAL_TIMEOUT_MS=2000
# AUTH_REDIS_PREFIX=rl:auth
#
# Redis TLS / URL (disabled/empty for local dev)
# GATEWAY_REDIS_TLS=false
# GATEWAY_REDIS_URL=
# AUTH_REDIS_TLS=false
# AUTH_REDIS_URL=
#
# Auth flow rate limits
# AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=5
# AUTH_FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MINUTES=15
# AUTH_FORGOT_PASSWORD_RATE_LIMIT_MAX_REQUESTS=3
# AUTH_RESET_PASSWORD_RATE_LIMIT_WINDOW_MINUTES=15
# AUTH_RESET_PASSWORD_RATE_LIMIT_MAX_REQUESTS=5

# =============================================================================
# Mercado Pago Integration (uncomment to enable real sandbox)
# ATENCION: Expo Go local REQUIERE que definas CHECKOUT_*_URL
# en .env.local con exp://<LAN_IP>:8081/--/checkout/result?checkout_status=...
# (los defaults bazaar:// solo funcionan en dev build / produccion).
# =============================================================================
# PAYMENT_PROVIDER=mercadopago
# MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxx
# PAYMENT_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app/webhooks/mercadopago
# MERCADOPAGO_WEBHOOK_SECRET=your-webhook-secret
# PAYMENT_EXPIRATION_MINUTES=30
#
# Checkout return URLs para MercadoPago (back_urls).
# Expo Go local:
#   CHECKOUT_SUCCESS_URL=exp://<lan-ip>:8081/--/checkout/result?checkout_status=success
#   CHECKOUT_FAILURE_URL=exp://<lan-ip>:8081/--/checkout/result?checkout_status=failure
#   CHECKOUT_PENDING_URL=exp://<lan-ip>:8081/--/checkout/result?checkout_status=pending
#
# Dev build / producción:
#   CHECKOUT_SUCCESS_URL=bazaar://checkout/result?checkout_status=success
#   CHECKOUT_FAILURE_URL=bazaar://checkout/result?checkout_status=failure
#   CHECKOUT_PENDING_URL=bazaar://checkout/result?checkout_status=pending
