# Archivo ejecutable de defaults locales para bazaar-platform.
# Los scripts lo cargan con `source`. Overrides opcionales en `.env.local`.

ENV_NAME=local

BAZAAR_API_GATEWAY_PATH=../Bazaar-backend-api-gateway
BAZAAR_AUTH_SERVICE_PATH=../bazaar-backend-auth-service
BAZAAR_CART_SERVICE_PATH=../bazaar-backend-cart-service
BAZAAR_CATALOG_SERVICE_PATH=../bazaar-backend-catalog-service
BAZAAR_ORDER_SERVICE_PATH=../bazaar-backend-order-service
BAZAAR_PAYMENT_SERVICE_PATH=../bazaar-backend-payment-service
BAZAAR_USER_SERVICE_PATH=../bazaar-backend-user-service
BAZAAR_BACKOFFICE_PATH=../bazaar-backoffice
BAZAAR_MOBILE_PATH=../bazaar-mobile

BACKEND_PROVIDER=local-docker
DATABASE_PROVIDER=local-docker
BACKOFFICE_PROVIDER=local-vite
MOBILE_RUNTIME_MODE=local-expo
BACKEND_STACK=full

LOCAL_API_BASE_URL=http://localhost:8080
BACKOFFICE_DEV_URL=http://localhost:5173
MOBILE_API_BASE_URL=http://localhost:8080
MOBILE_DEV_URL=http://localhost:8081

GATEWAY_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_LOGIN_RATE_LIMIT_MAX_REQUESTS=5
GATEWAY_RECOVERY_RATE_LIMIT_WINDOW_SECONDS=900
GATEWAY_RECOVERY_RATE_LIMIT_MAX_REQUESTS=5
GATEWAY_RATE_LIMIT_CLEANUP_INTERVAL_SECONDS=60

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379

GATEWAY_REDIS_ENABLED=true
GATEWAY_REDIS_HOST=redis
GATEWAY_REDIS_PORT=6379
GATEWAY_REDIS_DB=0
GATEWAY_REDIS_PASSWORD=
GATEWAY_REDIS_TIMEOUT_MS=100
GATEWAY_REDIS_PREFIX=rl
GATEWAY_USER_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_USER_RATE_LIMIT_MAX_REQUESTS=60

AUTH_REDIS_HOST=redis
AUTH_REDIS_PORT=6379
AUTH_REDIS_DB=1
AUTH_REDIS_PASSWORD=
AUTH_REDIS_TIMEOUT_MS=100
AUTH_REDIS_PREFIX=rl:auth

AUTH_LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=5
AUTH_FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_FORGOT_PASSWORD_RATE_LIMIT_MAX_REQUESTS=3
AUTH_RESET_PASSWORD_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RESET_PASSWORD_RATE_LIMIT_MAX_REQUESTS=5

# =============================================================================
# Google Federated Login (disabled by default)
# =============================================================================
# Para probar login federado local:
#   setear FEDERATED_LOGIN_ENABLED=true
#   setear GOOGLE_ALLOWED_CLIENT_IDS con los client IDs usados por mobile
GOOGLE_ALLOWED_CLIENT_IDS=
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo
FEDERATED_LOGIN_ENABLED=false

USER_DB_HOST_PORT=5433
AUTH_DB_HOST_PORT=5440
CATALOG_DB_HOST_PORT=5434
CART_DB_HOST_PORT=5436
CART_DB_NAME=cart_db
ORDER_DB_HOST_PORT=5437
PAYMENT_DB_HOST_PORT=5438

INTERNAL_SERVICE_TOKEN=bazaar-dev-internal-token

# =============================================================================
# Mercado Pago Integration
# =============================================================================
# PAYMENT_PROVIDER=mock                                        # mock | mercadopago
# PAYMENT_SIMULATION_MODE=approved                             # approved | rejected | pending (mock mode only)
# MERCADOPAGO_ACCESS_TOKEN=                                    # Sandbox: starts with TEST-
# PAYMENT_WEBHOOK_URL=http://localhost:18084/webhooks/mercadopago
# MERCADOPAGO_WEBHOOK_SECRET=                                  # Secret for HMAC validation
# PAYMENT_EXPIRATION_MINUTES=30
#
# Checkout return URLs (back_urls de MercadoPago).
# ======================================================================
# Expo Go local (REQUIERE override en .env.local):
#   CHECKOUT_SUCCESS_URL=exp://<lan-ip>:8081/--/checkout/result?checkout_status=success
#   CHECKOUT_FAILURE_URL=exp://<lan-ip>:8081/--/checkout/result?checkout_status=failure
#   CHECKOUT_PENDING_URL=exp://<lan-ip>:8081/--/checkout/result?checkout_status=pending
#
# Dev build / producción (custom scheme bazaar://):
#   CHECKOUT_SUCCESS_URL=bazaar://checkout/result?checkout_status=success
#   CHECKOUT_FAILURE_URL=bazaar://checkout/result?checkout_status=failure
#   CHECKOUT_PENDING_URL=bazaar://checkout/result?checkout_status=pending
