# ============================================================================
# Maintenance — Environment Configuration (Render)
#
# Copy this file to .env.cleanup and fill in the real values.
# .env.cleanup is gitignored — never commit it.
#
# Get DB URLs from Render dashboard → service → Environment → DATABASE_URL.
# ============================================================================

# ── API Gateway ───────────────────────────────────────────────────────────────

# Base URL of the Render API gateway (used by seed scripts to call catalog API).
RENDER_API_BASE_URL="https://bazaar-backend-api-gateway.onrender.com"

# ── Database URLs (for cleanup_e2e scripts) ───────────────────────────────────

# Auth service DB
AUTH_DB_URL="postgres://user:pass@host:5432/auth_db?sslmode=require"

# User service DB
USER_DB_URL="postgres://user:pass@host:5432/user_db?sslmode=require"

# Catalog service DB
CATALOG_DB_URL="postgres://user:pass@host:5432/catalog_db?sslmode=require"

# Cart service DB
CART_DB_URL="postgres://user:pass@host:5432/cart_db?sslmode=require"

# Order service DB
ORDER_DB_URL="postgres://user:pass@host:5432/order_db?sslmode=require"

# Payment service DB
PAYMENT_DB_URL="postgres://user:pass@host:5432/payment_db?sslmode=require"

# ── Seed Seller Credentials (for seed_render_products / delete_render_seed_products) ──

# The seller user that will own the 50 seed products.
# Must be a registered user with "seller" role.
# Provide these as environment variables (or put them in .env.cleanup — gitignored).
# SEED_SELLER_EMAIL="seller@example.com"
# SEED_SELLER_PASSWORD="your-password-here"

# ── Alternative: export on the command line ────────────────────────────────────
#
#   export SEED_SELLER_EMAIL="seller@example.com"
#   export SEED_SELLER_PASSWORD="..."
#   CONFIRMATION="CONFIRMO POBLAR PRODUCTOS RENDER" \
#     ./scripts/maintenance/seed_render_products.sh
