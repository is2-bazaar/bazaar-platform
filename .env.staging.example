# Contrato documental de staging para bazaar-platform.
# Este archivo NO es ejecutado por los scripts locales.
# No incluir secretos reales ni variables internas del backend.

ENV_NAME=staging

BACKEND_PROVIDER=render
DATABASE_PROVIDER=neon
BACKOFFICE_PROVIDER=vercel
MOBILE_RUNTIME_MODE=manual

BACKEND_BASE_URL=https://<backend-staging>.onrender.com
BACKOFFICE_BASE_URL=https://<backoffice-staging>.vercel.app
MOBILE_API_BASE_URL=https://<backend-staging>.onrender.com
