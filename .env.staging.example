# GitHub Environment variables for the deploy workflow
STAGING_HOST=example.com
STAGING_USER=deploy

STAGING_DB_URL='postgresql://user:password@host/db?sslmode=require'
STAGING_JWT_SECRET='replace-me'
STAGING_CORS_ALLOWED_ORIGINS='https://staging.example.com'
GHCR_USERNAME='gh-username' #RELLENAR
GHCR_TOKEN='ghcr-token' #RELLENAR
API_GATEWAY_IMAGE='ghcr.io/org/bazaar-api-gateway:sha-xxxx'
IDENTITY_SERVICE_IMAGE='ghcr.io/org/bazaar-identity-service:sha-xxxx'
SKIP_DOCKER_PULL=false

DB_URL='postgresql://user:password@host/db?sslmode=require'
JWT_SECRET='replace-me'
CORS_ALLOWED_ORIGINS='https://staging.example.com'
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8080
