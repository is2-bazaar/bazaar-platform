flowchart LR

%% =====================================================
%% SHARED DOMAIN COLORS
%% =====================================================

classDef auth fill:#E3F2FD,stroke:#1E88E5,color:#0D47A1,stroke-width:2px;
classDef user fill:#E8F5E9,stroke:#43A047,color:#1B5E20,stroke-width:2px;
classDef catalog fill:#FFF3E0,stroke:#FB8C00,color:#E65100,stroke-width:2px;
classDef cart fill:#F3E5F5,stroke:#8E24AA,color:#4A148C,stroke-width:2px;
classDef order fill:#FCE4EC,stroke:#D81B60,color:#880E4F,stroke-width:2px;
classDef payment fill:#ECEFF1,stroke:#546E7A,color:#263238,stroke-width:2px;
classDef gateway fill:#E0F7FA,stroke:#00ACC1,color:#006064,stroke-width:2px;

linkStyle default stroke:#90A4AE,stroke-width:1.5px;


subgraph AUTH["auth-service"]
    direction TB

    User["User"]
    AuthSession["AuthSession"]
    PasswordResetCode["PasswordResetCode"]

    User --> AuthSession
    User --> PasswordResetCode
end

class User,AuthSession,PasswordResetCode auth

subgraph USER["user-service"]
    direction TB

    Profile["Profile"]
end

class Profile user

subgraph CATALOG["catalog-service"]
    direction TB

    Product["Product"]
    StockReservation["StockReservation"]
    StockReservationItem["StockReservationItem"]
    StockRestorationOperation["StockRestorationOperation"]
    IdempotencyKey["IdempotencyKey"]

    StockReservation --> StockReservationItem
end

class Product,StockReservation,StockReservationItem,StockRestorationOperation,IdempotencyKey catalog

subgraph CART["cart-service"]
    direction TB

    Cart["Cart"]
    CartItem["CartItem"]
    CartCleanupOperation["CartCleanupOperation"]

    Cart --> CartItem
end

class Cart,CartItem,CartCleanupOperation cart

subgraph ORDER["order-service"]
    direction TB

    CheckoutGroup["CheckoutGroup"]
    Order["Order"]
    OrderItem["OrderItem"]
    OrderStatusHistory["OrderStatusHistory"]

    CheckoutGroup --> Order
    Order --> OrderItem
    Order --> OrderStatusHistory
end

class CheckoutGroup,Order,OrderItem,OrderStatusHistory order

subgraph PAYMENT["payment-service"]
    direction TB

    Payment["Payment"]
    Refund["Refund"]
    WebhookEvent["WebhookEvent"]

    Payment --> Refund
end

class Payment,Refund,WebhookEvent payment

Profile -. references .-> User
CartItem -. product snapshot .-> Product
OrderItem -. purchased product .-> Product
CheckoutGroup -. payment flow .-> Payment
CheckoutGroup -. stock reservation .-> StockReservation
StockReservationItem -. reserves .-> Product
Order -. buyer/seller .-> User
Product -. seller .-> User
